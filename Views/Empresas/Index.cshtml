@model List<Sistema_IAM.ViewModels.EmpresaViewModel>

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest"
        ? null
        : "_Layout";

    ViewData["Title"] = "Empresas";
}

<h1>Empresas</h1>

<a asp-controller="Empresas" asp-action="Crear" class="btn btn-sm btn-success" data-ajax="true">
    Agregar Usuario
</a>

<table class="table table-sm table-hover table-bordered mt-2">
    <thead  class="table-primary">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nombre</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var empresa in Model)
        {
            <tr>
                <td scope="row">@empresa.Id</td>
                <td>@empresa.Nombre</td>
                <td>
                    <a asp-controller="Empresas" asp-action="Editar" asp-route-id="@empresa.Id" class="btn btn-sm btn-primary me-2">
                        Editar
                    </a>
                    <form asp-controller="Empresas" asp-action="Eliminar" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@empresa.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>