@model Sistema_IAM.ViewModels.EmpresaViewModel

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest"
        ? null
        : "_Layout";

    ViewData["Title"] = "Nueva Empresa";
}

<h1>Crear Empresa</h1>

<form asp-controller="Empresas" asp-action="Registrar" method="post">

    <div>
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" />
        <span asp-validation-for="Nombre"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Activo" class="form-label">Estado</label>

        <select asp-for="Activo" class="form-select">
            <option value="true">Activa</option>
            <option value="false">Inactiva</option>
        </select>

        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>

    <button type="submit">Registrar</button>

</form>