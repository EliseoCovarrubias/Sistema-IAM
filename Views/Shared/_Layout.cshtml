<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema IAM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sistemas_usuarios.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex min-vh-100">

        <!-- MENU LATERAL -->
        <aside class="sidebar bg-dark text-white d-flex flex-column">

            <div class="sidebar-header p-3 border-bottom border-secondary">
                <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none fw-bold fs-5">
                    Sistema Usuarios
                </a>
            </div>

            <nav class="nav flex-column p-3 gap-1">

                <span class="sidebar-label text-uppercase text-secondary small mb-2">
                    Principal
                </span>

                <a asp-controller="Empresas" asp-action="Index" class="sidebar-link" data-ajax="true">
                    <span class="me-2">♙</span> Empresas
                </a>

                <a asp-controller="Usuarios" asp-action="Index" class="sidebar-link" data-ajax="true">
                    <span class="me-2">♙</span> Usuarios
                </a>

            </nav>

            <div class="mt-auto p-3 border-top border-secondary">
                <span class="small text-secondary">
                    Sistema de Usuarios · v1.0
                </span>
            </div>

        </aside>

        <!-- AREA DERECHA -->
        <div class="main-area d-flex flex-column flex-grow-1">

            <header class="topbar bg-white border-bottom px-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-secondary">
                            Panel de administración
                        </h6>
                    </div>

                    <span class="small text-muted">
                        Proyecto .NET MVC
                    </span>
                </div>
            </header>

            <main id="contenido-principal"
                role="main"
                class="content-area p-4 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="bg-white border-top text-muted px-4 py-3 small">
                &copy; 2026 - Sistema de Usuarios
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
