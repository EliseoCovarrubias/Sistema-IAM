@model Sistema_IAM.ViewModels.UsuarioViewModel

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest"
        ? null
        : "_Layout";

    ViewData["Title"] = "Nuevo usuario";
}

<h1>Crear Usuario</h1>

<form asp-controller="Usuarios" asp-action="Registrar" method="post">

    <div>
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" />
        <span asp-validation-for="Nombre"></span>
    </div>

    <div>
        <label asp-for="Correo"></label>
        <input asp-for="Correo" />
        <span asp-validation-for="Correo"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdEmpresa" class="form-label">Empresa</label>

        <select asp-for="IdEmpresa"
                asp-items="ViewBag.Empresas"
                class="form-select">
            <option value="">Selecciona una empresa</option>
        </select>

        <span asp-validation-for="IdEmpresa" class="text-danger"></span>
    </div>

    <button type="submit">Registrar</button>

</form>