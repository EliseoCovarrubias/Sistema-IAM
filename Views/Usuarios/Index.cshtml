@model List<Sistema_IAM.ViewModels.UsuarioViewModel>

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest"
        ? null
        : "_Layout";

    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<a asp-controller="Usuarios" asp-action="Crear" class="btn btn-sm btn-success" data-ajax="true">
    Agregar Usuario
</a>

<table class="table table-sm table-hover table-bordered mt-2">
    <thead  class="table-primary">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nombre</th>
            <th scope="col">Correo</th>
            <th scope="col">Empresa</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td scope="row">@usuario.Id</td>
                <td>@usuario.Nombre</td>
                <td>@usuario.Correo</td>
                <td>@usuario.Empresa</td>
                <td>
                    <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-sm btn-primary me-2">
                        Editar
                    </a>
                    <form asp-controller="Usuarios" asp-action="Eliminar" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@usuario.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>